# Copy to .env.local for local development. Set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values. Everything below is optional: each feature reports itself as unavailable
# (HTTP 503 + honest UI message) until its variables are set.

# ── Site ──────────────────────────────────────────────────────────────────────
# Canonical origin used in canonicals, Open Graph, JSON-LD and the sitemap.
VITE_SITE_URL=https://core-seven-henna.vercel.app
# Search indexing. Defaults to true only when VERCEL_ENV=production; previews and local builds are noindex.
# Set explicitly to "true" or "false" to override.
ALLOW_INDEXING=

# ── Stripe (use TEST keys: sk_test_… / whsec_… from test mode) ────────────────
# Live keys are refused while src/catalog/products.ts has CATALOG_IS_SAMPLE = true.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at /api/stripe-webhook.
STRIPE_WEBHOOK_SECRET=
# "true" enables Stripe Tax on Checkout Sessions (requires Stripe Tax to be set up in the dashboard).
STRIPE_AUTOMATIC_TAX=false

# ── Resend (newsletter + contact form + merchant order emails) ────────────────
RESEND_API_KEY=
# Segment that newsletter sign-ups are added to.
RESEND_SEGMENT_ID=
# Inbox that receives contact-form messages.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "NOVA <support@your-domain.com>".
CONTACT_FROM_EMAIL=
# Optional: receives a notification for every paid order.
ORDER_NOTIFICATION_EMAIL=

# ── Upstash Redis (recommended: atomic once-only order fulfillment) ───────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Analytics (optional) ──────────────────────────────────────────────────────
# GA4 measurement ID (G-XXXXXXX). Not loaded when unset or when the visitor sends GPC / Do Not Track.
# VITE_GA_ID is accepted as an alias; set only one.
VITE_GA4_ID=
# Google Search Console HTML-tag verification: paste only the content="…" token, not the whole tag.
VITE_GSC_VERIFICATION=
