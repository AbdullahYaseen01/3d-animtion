{
  "name": "nova-storefront",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "images": "node scripts/build-images.mjs",
    "qa:screens": "node scripts/qa/screenshots.mjs",
    "qa:perf": "node scripts/qa/perf.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.4",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  }
}
